      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "get_file_contents",
      "description": "Get the contents of a file or directory from a GitHub repository.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Absolute path"
          }
        },
        "required": [
